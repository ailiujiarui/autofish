{
  "schemaVersion": 1,
  "id": "autofish",
  "version": "${mod_version}",
  "name": "Auto Fish",
  "description": "A configurable automatic fishing mod for Minecraft 26.1.2, ported from troyhayes/autofish.",
  "authors": [
    "troyhayes",
    "ximu"
  ],
  "contact": {
    "sources": "https://github.com/troyhayes/autofish"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.ximu.autofish.client.AutoFishClient"
    ]
  },
  "mixins": [
    "autofish.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
